# H3C 连接池服务配置模板（示例）
# 复制为 .env 后按需修改。服务端与客户端脚本会自动加载仓库根目录下的 .env。
# 已存在的环境变量优先（不会被 .env 覆盖）。

# 服务监听地址（默认 127.0.0.1）
NETMIKO_POOL_HOST=127.0.0.1

# 服务监听端口（默认 8765）
NETMIKO_POOL_PORT=8765

# 设备地址（默认 192.168.56.1）
NETMIKO_POOL_DEVICE_IP=192.168.56.1

# 客户端访问的服务地址（默认 http://127.0.0.1:8765）
# 注意：若修改了上方的服务端口，请同步修改此处。
NETMIKO_POOL_URL=http://127.0.0.1:8765

# JWT 签名密钥（可选但推荐）。作为 HS256 签名密钥，客户端用它签发短时效 JWT（默认 5 分钟有效）
# 放在 X-Auth-Token header。设置后除 /health 外所有端点校验该 JWT；未设置则运行在无鉴权模式（仅本机可访问）。
NETMIKO_POOL_JWT_SECRET=
